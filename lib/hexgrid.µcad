//
// Honeycomb hex-grid generation + a shared cell-coordinate system, used by the
// floor and walls and as the universal mounting grid for accessories.
//
// Orientation: hexagons have FLATS on top & bottom (points left/right). A
// column of hexes stacks vertically with a uniform wall; adjacent columns are
// staggered by half a row. Classic honeycomb tiling.
//
// THE CELL COORDINATE SYSTEM (the contract every accessory relies on):
//   * Integer (col, row) addresses a hole. col runs in X, row in Y.
//   * `cell_x(col)` / `cell_y(col, row)` give the exact centre of that hole.
//   * Odd columns are staggered up by row_pitch/2.
//   * The whole `cols x rows` field is centred on the origin, so a holder that
//     uses the same cell_x/cell_y lands its plugs exactly in the holes.
//
// Master parameters (lib/params.µcad): HEX_AF, HEX_WALL.

use std::geo2d::*;
use std::ops::*;

const SQRT3 = 1.7320508075688772;

pub fn hex_radius(af: Length) {
    af / SQRT3
}

// Horizontal centre-to-centre pitch between adjacent COLUMNS.
pub fn col_pitch(af: Length, wall: Length) {
    0.75 * (2 * (af / SQRT3)) + (wall * (SQRT3 / 2))
}

// Vertical centre-to-centre pitch within a COLUMN.
pub fn row_pitch(af: Length, wall: Length) {
    af + wall
}

// Centre X of column `col` in a `cols`-wide field centred on the origin.
pub fn cell_x(col: Integer, cols: Integer, af: Length, wall: Length) {
    (col - (cols - 1) / 2) * col_pitch(af = af, wall = wall)
}

// Centre Y of (col,row) in a `rows`-tall field centred on the origin.
// Odd columns are staggered up by half a row. (No modulo operator in µcad, so
// parity is computed as col - 2*floor(col/2).)
pub fn cell_y(col: Integer, row: Integer, rows: Integer, af: Length, wall: Length) {
    rp = row_pitch(af = af, wall = wall);
    base = (row - (rows - 1) / 2) * rp;
    parity = col - 2 * std::math::int(col / 2);
    base + parity * (rp / 2)
}

// How many columns/rows of cells fit in a span, leaving `margin` solid border.
// Always returns at least 1 (a single centred cell still fits if span allows).
pub fn fit_cols(span: Length, margin: Length, af: Length, wall: Length) {
    n = std::math::int((span - 2 * margin - af) / col_pitch(af = af, wall = wall)) + 1;
    if n < 1 { 1 } else { n }
}

pub fn fit_rows(span: Length, margin: Length, af: Length, wall: Length) {
    n = std::math::int((span - 2 * margin - af) / row_pitch(af = af, wall = wall)) + 1;
    if n < 1 { 1 } else { n }
}

// A 2D honeycomb of `cols x rows` hexes centred on the origin, on the shared
// cell lattice. Subtract from a plate to perforate it.
pub sketch HexField(
    cols: Integer,
    rows: Integer,
    af: Length,
    wall: Length,
) {
    r  = af / SQRT3;
    cp = col_pitch(af = af, wall = wall);
    rp = row_pitch(af = af, wall = wall);

    // Split columns by parity so each parity is a single multiplicity with a
    // uniform Y stagger. Even columns: indices 0,2,4,...; odd: 1,3,5,...
    n_even = std::math::int((cols + 1) / 2);
    n_odd  = std::math::int(cols / 2);

    even_x = (([0 .. n_even - 1] * 2) - (cols - 1) / 2) * cp;
    odd_x  = ((([0 .. n_odd - 1] * 2) + 1) - (cols - 1) / 2) * cp;

    base_y = ([0 .. rows - 1] - (rows - 1) / 2) * rp;

    Hexagon(radius = r).translate(x = even_x, y = base_y);
    Hexagon(radius = r).translate(x = odd_x, y = base_y + rp / 2);
}

// Convenience: choose a cols x rows field that fills width x height (minus
// margin) — returns nothing, it's documentation of the intended call pattern.
// Callers compute cols/rows with fit_cols/fit_rows and pass them to HexField.
