//
// Stacking interlock: corner pegs (point up) and corner sockets (point down).
//
// Coordinate convention used across this library:
//   * X,Y are centered on the footprint (origin at footprint centre).
//   * Z=0 is the bottom of the tray; the tray grows upward in +Z.

use std::geo3d::*;
use std::ops::*;

// Corner peg/socket X and Y centres, derived from the footprint and inset.
// Functions take NAMED arguments in µcad; the last expression is the result.
pub fn peg_xs(footprint_w: Length, inset: Length) {
    [-footprint_w / 2 + inset, footprint_w / 2 - inset]
}

pub fn peg_ys(footprint_d: Length, inset: Length) {
    [-footprint_d / 2 + inset, footprint_d / 2 - inset]
}

// Four pegs standing on top of a rim at height `rim_z`, protruding `h`.
// Cylinder is centered on Z, so to sit ON the rim we translate by rim_z + h/2.
pub part Pegs(
    footprint_w: Length,
    footprint_d: Length,
    inset: Length,
    d: Length,
    h: Length,
    rim_z: Length,
) {
    Cylinder(diameter = d, height = h)
        .translate(z = rim_z + h / 2)
        .translate(
            x = peg_xs(footprint_w = footprint_w, inset = inset),
            y = peg_ys(footprint_d = footprint_d, inset = inset),
        );
}

// Four sockets to be SUBTRACTED from the underside of a tray floor.
// They are bored upward from z=0 to z=depth.
pub part Sockets(
    footprint_w: Length,
    footprint_d: Length,
    inset: Length,
    d: Length,
    depth: Length,
) {
    Cylinder(diameter = d, height = depth)
        .translate(z = depth / 2)
        .translate(
            x = peg_xs(footprint_w = footprint_w, inset = inset),
            y = peg_ys(footprint_d = footprint_d, inset = inset),
        );
}
